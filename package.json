{
  "name": "aura-proximity",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "ios:build": "bash scripts/build-ios.sh",
    "test:browser": "node tests/browser.mjs",
    "backup": "node scripts/backup.mjs",
    "android:build": "bash scripts/build-android.sh :app:assembleDebug :app:lintDebug",
    "android:test": "bash scripts/test-android-rules.sh",
    "android:test:device": "node scripts/test-android-device.mjs",
    "test:spatial": "bash scripts/test-spatial.sh"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@playwright/test": "1.56.1"
  }
}
